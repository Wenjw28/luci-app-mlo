#!/bin/sh /etc/rc.common
# SPDX-License-Identifier: GPL-2.0-only
# mlo-guard - 开机守护（MLO 起不来时回退 + LAN 设备名自愈）
START=95
STOP=05
USE_PROCD=1

start_service() {
	if [ -x /usr/bin/mlo-boot-guard ]; then
		procd_open_instance boot
		procd_set_param command /usr/bin/mlo-boot-guard
		procd_set_param respawn 0 0 0
		procd_set_param stdout 1
		procd_set_param stderr 1
		procd_close_instance
	fi

	if [ -x /usr/bin/mlo-lan-guard ]; then
		procd_open_instance lan
		procd_set_param command /usr/bin/mlo-lan-guard
		procd_set_param respawn 3600 5 0
		procd_set_param stdout 1
		procd_set_param stderr 1
		procd_close_instance
	fi
}
